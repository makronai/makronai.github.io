<main id="main-content" class="workbench-main">
  <!-- Minimalist Title & Theme Toggle -->
  <div class="app-top-bar">
    <div>
      <h1 class="app-title">AI Detector &amp; Humanizer</h1>
      <p class="app-subtitle">Private, client-side stylistic analysis and automatic rewriting engine.</p>
    </div>
    <div class="app-actions">
      <button type="button" class="btn-ghost" id="theme-toggle-btn" aria-label="Toggle Theme">
        <span id="theme-icon" aria-hidden="true">🌓</span> <span id="theme-label">Theme</span>
      </button>
    </div>
  </div>

  <!-- Mobile View Toggle Tabs (Hidden on Desktop) -->
  <div class="mobile-tabs" role="tablist" aria-label="Mobile View Toggle">
    <button type="button" class="mobile-tab mobile-tab--active" id="tab-btn-orig" role="tab" aria-selected="true" onclick="App.setMobileTab('orig')">
      Original <span class="tab-score-badge" id="mobile-orig-score">—</span>
    </button>
    <button type="button" class="mobile-tab" id="tab-btn-human" role="tab" aria-selected="false" onclick="App.setMobileTab('human')">
      Humanized <span class="tab-score-badge" id="mobile-human-score">—</span>
    </button>
  </div>

  <!-- Main Dual-Pane Workbench -->
  <div class="workbench-shell" id="workbench-shell">
    
    <!-- LEFT COLUMN: ORIGINAL TEXT -->
    <section class="pane pane-original" id="pane-original">
      <div class="pane-header">
        <div class="pane-title-group">
          <span class="pane-title">Original Text</span>
          <div class="score-pill score-pill--empty" id="orig-score-pill" title="Heuristic AI pattern match score based on syntactic uniformity and buzzwords">
            <span class="score-dot"></span>
            <span id="orig-score-val">0% AI Score</span>
          </div>
        </div>
        
        <div class="pane-tools">
          <label class="btn-ghost btn-file-label" title="Upload TXT, MD, PDF, DOC, or DOCX">
            <span>Import Document</span>
            <input type="file" id="file-uploader" accept=".txt,.md,.pdf,.doc,.docx" class="sr-only">
          </label>
          <button type="button" class="btn-ghost" id="load-sample-btn">Sample</button>
          <button type="button" class="btn-ghost" id="clear-btn">Clear</button>
        </div>
      </div>

      <div class="textarea-wrapper" id="drop-zone">
        <textarea 
          id="input-original" 
          class="workbench-textarea" 
          placeholder="Paste text here or drag and drop files (.txt, .md, .pdf, .docx, .doc)..."
          aria-label="Original Text Input"
          spellcheck="true"></textarea>
        <div class="drop-overlay" id="drop-overlay">Drop file to extract text</div>
      </div>

      <div class="pane-footer">
        <span class="stat-text" id="orig-word-count">0 words &bull; 0 chars</span>
        <button type="button" class="btn-primary" id="humanize-btn">
          <span>Auto-Humanize &rarr;</span>
        </button>
      </div>
    </section>

    <!-- RIGHT COLUMN: HUMANIZED TEXT -->
    <section class="pane pane-humanized" id="pane-humanized">
      <div class="pane-header">
        <div class="pane-title-group">
          <span class="pane-title">Humanized Result</span>
          <div class="score-pill score-pill--empty" id="human-score-pill" title="AI Pattern Score after automatic simplification and cadence restructuring">
            <span class="score-dot"></span>
            <span id="human-score-val">—</span>
          </div>
        </div>

        <div class="pane-tools">
          <button type="button" class="btn-ghost" id="toggle-diff-btn">Show Diff</button>
          <button type="button" class="btn-ghost" id="copy-btn">Copy</button>
          <button type="button" class="btn-ghost" id="download-btn">Export</button>
        </div>
      </div>

      <div class="textarea-wrapper">
        <textarea 
          id="output-humanized" 
          class="workbench-textarea" 
          placeholder="Humanized text will appear here automatically..."
          aria-label="Humanized Text Output"
          spellcheck="true"></textarea>
        <div class="diff-view" id="diff-view" style="display: none;"></div>
      </div>

      <div class="pane-footer">
        <span class="stat-text" id="human-word-count">0 words</span>
        <span class="status-indicator" id="status-message">All calculations 100% client-side</span>
      </div>
    </section>

  </div>

  <!-- Disclaimer Footer -->
  <p class="scientific-notice">
    * Note: Percentage indicates an observable heuristic pattern score (syntactic uniformity, burstiness, and cliché frequency). Scores are for stylistic guidance and do not guarantee human or machine authorship.
  </p>
</main>

<img src="https://tracker.makron.workers.dev/?token=ai-detector-humanizer"
     width="1" height="1" style="display:none;" alt="dumb image"></img>
<link rel="stylesheet" href="/ai-detector-humanizer/ai-tool.css">
<script src="/ai-detector-humanizer/ai-tool.js" defer></script>
