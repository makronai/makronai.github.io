<div class="image-tool-app">
    <div class="app-left">
        <div class="preview-container" id="previewContainer">
            <div class="upload-placeholder" id="previewPlaceholder">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 10px; color: var(--primary);"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                <h3>Upload an Image</h3>
                <p>Drag & drop or click to browse</p>
            </div>
            <img id="previewImage" alt="Image Preview">
        </div>
        
        <div class="file-input-wrapper">
            <input type="file" id="fileInput" accept="image/*">
            <label for="fileInput" class="btn-secondary">Choose New Image</label>
        </div>
    </div>

    <div class="app-right">
        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab('tab-resize', this)">Resize</button>
            <button class="tab-btn" onclick="switchTab('tab-transform', this)">Transform</button>
            <button class="tab-btn" onclick="switchTab('tab-filters', this)">Effects</button>
            <button class="tab-btn" onclick="switchTab('tab-export', this)">Export</button>
        </div>

        <div class="tab-content-wrapper">
            <div id="tab-resize" class="tab-content active">
                <div class="panel-section">
                    <h4 class="section-title">Dimensions</h4>
                    <div class="input-grid">
                        <div class="input-group">
                            <label>Width (px)</label>
                            <input type="number" id="imgWidth" oninput="handleResize('width')">
                        </div>
                        <div class="input-group">
                            <label>Height (px)</label>
                            <input type="number" id="imgHeight" oninput="handleResize('height')">
                        </div>
                    </div>
                    <div class="checkbox-group">
                        <input type="checkbox" id="keepAspect" checked onchange="invalidateResult()">
                        <label for="keepAspect">Constrain Proportions</label>
                    </div>
                </div>
            </div>

            <div id="tab-transform" class="tab-content">
                <div class="panel-section">
                    <h4 class="section-title">Rotate</h4>
                    <div class="button-grid">
                        <button class="btn-outline" onclick="applyTransform('rotate', -90)">↺ -90°</button>
                        <button class="btn-outline" onclick="applyTransform('rotate', 90)">↻ +90°</button>
                    </div>
                </div>
                <div class="panel-section">
                    <h4 class="section-title">Flip</h4>
                    <div class="button-grid">
                        <button class="btn-outline" onclick="applyTransform('flipH')">↔ Horizontal</button>
                        <button class="btn-outline" onclick="applyTransform('flipV')">↕ Vertical</button>
                    </div>
                </div>
                <button class="btn-text" onclick="resetTransform()">Reset Transforms</button>
            </div>

            <div id="tab-filters" class="tab-content">
                <div class="panel-section" id="filterControls">
                    </div>
                <button class="btn-text" onclick="resetFilters()">Reset All Effects</button>
            </div>

            <div id="tab-export" class="tab-content">
                <div class="panel-section">
                    <h4 class="section-title">Format Settings</h4>
                    <div class="input-group">
                        <label>Output Format</label>
                        <select id="formatSelect" onchange="handleFormatChange()">
                            <option value="image/png">PNG (Supports Transparency)</option>
                            <option value="image/jpeg">JPEG</option>
                            <option value="image/webp">WEBP (Modern & Compact)</option>
                        </select>
                    </div>
                    <div class="input-group" id="qualityGroup" style="display: none; margin-top: 15px;">
                        <label>Image Quality: <span id="qualityVal">90</span>%</label>
                        <input type="range" id="exportQuality" min="10" max="100" value="90" oninput="document.getElementById('qualityVal').innerText = this.value; invalidateResult();">
                    </div>
                </div>
            </div>
        </div>

        <div class="action-footer">
            <div class="status-bar">
                <progress id="progressBar" value="0" max="100"></progress>
                <small id="statusText">Awaiting Image...</small>
            </div>
            <button class="btn-primary action-btn" onclick="processAndDownload()" id="processBtn" disabled>Process Image</button>
            <a id="downloadLink" class="btn-success" style="display: none;">Download File</a>
        </div>
    </div>
</div>

<canvas id="canvas" style="display: none;"></canvas>
<script src="/image-tools/image.js" defer></script>
<link rel="stylesheet" href="/image-tools/image.css">