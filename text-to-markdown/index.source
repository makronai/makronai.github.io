  <div id="app" style="font-family:sans-serif; max-width:500px;">
  <textarea id="io" placeholder="Paste text here..." style="width:100%; height:200px; border:2px dashed #ccc; border-radius:8px; padding:10px;"></textarea>
  <p style="font-size:12px; color:#666;">Pasting converts to MD. Click the box to copy result.</p>
</div>
  
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lamejs/1.2.1/lame.all.min.js"></script>
    <script src="/text-to-markdown/markdown.js" defer></script>